# Pooled PostgreSQL connection used by the running application.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public"

# Direct PostgreSQL connection used by Prisma CLI and administrative tooling.
DIRECT_URL="postgresql://USER:PASSWORD@DIRECT_HOST:5432/DATABASE?schema=public"

# Generate with: npx auth secret
AUTH_SECRET="replace-with-a-random-secret"

# Optional deployment origin. Set this when Auth.js cannot infer the public URL.
# AUTH_URL="http://localhost:3000"

# Trusted server-side origin used for secure Quote links and SEO metadata.
# Keep localhost in local development; use https://quotevia.co.za in production.
APP_URL="http://localhost:3000"

# Resend transactional email. Keep the API key server-only.
RESEND_API_KEY="re_replace_with_a_resend_api_key"
EMAIL_FROM="QuoteKit <quotes@example.com>"

# Optional Help & Support contact address.
SUPPORT_EMAIL="support@example.com"

# Development seed only. Do not configure these in production.
SEED_USER_NAME="Development Owner"
SEED_USER_EMAIL="owner@quotekit.local"
SEED_USER_PASSWORD="replace-with-development-only-password"
SEED_ORGANIZATION_NAME="QuoteKit Development"
